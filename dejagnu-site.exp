# Site file for running the gcc testsuite on the volamos and vamos boards in
# baseboards/. Pass it as DEJAGNU=$PWD/dejagnu-site.exp; the path is
# taken from this file's own location, so it works from any directory.
set here [file dirname [file normalize [info script]]]
lappend boards_dir [file join $here baseboards]
unset here

# DEJAGNU_TMPDIR gives a run a tmpdir of its own, for runs in parallel: the
# testsuite's site.exp, which runtest loads before this file, sets one shared
# tmpdir, and the tests build their executables there.
if {[info exists env(DEJAGNU_TMPDIR)]} {
    set tmpdir $env(DEJAGNU_TMPDIR)
}
