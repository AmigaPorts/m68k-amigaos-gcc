# This is a list of toolchains that are supported on this board.
set_board_info target_install {m68k-amigaos}

# basic-sim.exp is a basic description for the standard Cygnus simulator.
load_base_board_description "basic-sim"

# Load the generic configuration for this board. This will define a basic
# set of routines needed by the tool to communicate with the board.
load_generic_config "sim"

# Default the simulator here, but only if not already overridden by a
# runtest/make SIM= on the command line: setup_sim (via find_sim) uses the
# global SIM if it is set, so setting our default beforehand still lets an
# explicit override win, while setup_sim populates board_info from it.
if {![info exists SIM]} {
    set SIM volamos
}
setup_sim amigaos
# --sanitize: volamos checks guest memory accesses and fails the run on a
# violation (exit status 99).  A runtest SANITIZE=0 leaves it out; the
# Makefile passes that for the C++ suite, whose -fstrub tests read the
# scrubbed stack below the stack pointer on purpose.
# --cpu 68000: this board builds 68000 code, so run it on one, which traps
# the misaligned word and long accesses a 68020 tolerates.
set volamos_options "--cpu 68000 --stack 4096K --ram 11264K"
if {![info exists SANITIZE] || $SANITIZE} {
    append volamos_options " --sanitize"
}

# Options after the board name are added to every compile and link, as in
# board=volamos/-mcrt=clib2/-m68020/-m68881, and volamos follows them: the
# CPU, the FPU, and ixemul.library for -mcrt=ixemul.
process_multilib_options ""
set variant_flags [board_info $board multilib_flags]
if {[regexp -- {-m(?:cpu=)?(680[2346]0)} $variant_flags -> cpu]} {
    regsub -- {--cpu \S+} $volamos_options "--cpu $cpu" volamos_options
}
set variant_fpu [regexp -- {-m68881|-mhard-float} $variant_flags]
if {$variant_fpu} {
    append volamos_options " --fpu"
}
set variant_ixemul [string match "*-mcrt=ixemul*" $variant_flags]
if {$variant_ixemul} {
    set libs [expr {$variant_fpu ? "IXEMUL_FPU_LIBS" : "IXEMUL_LIBS"}]
    if {![info exists ::env($libs)]} {
        error "volamos: $libs (the ixemul.library directory) is not set"
    }
    append volamos_options " --libs-dir $::env($libs)"
}
set_board_info sim,options $volamos_options
# Wall-clock limit for each program run; sim.exp's default is 240 s.  The
# slowest tests take about 10 s, 40 s on a loaded machine, so a hang costs a
# parallel slot 2 minutes rather than 4.
set_board_info sim_time_limit 120

set_board_info compiler "[find_gcc]"
# libnix unless a variant picks another runtime: two -mcrt= options conflict.
if {[string match "*-mcrt=*" $variant_flags]} {
    set_board_info cflags ""
} else {
    set_board_info cflags "-mcrt=nix20"
}
set_board_info ldscript "";

set_board_info gcc,stack_size 4096
set_board_info isremote 0
set_board_info slow_simulator 0

set_board_info gdb_protocol "remote"
set_board_info gdb,nosignals 1
set_board_info gdb,cannot_call_functions 1

set timeout 30

