#!/bin/bash
# Run libc-test's math tests on a C runtime under volamos, for make check-libc-test.
#
#   scripts/libc-test-math <libc-test> <outdir> <prefix> <crt> [cflags...]
#
# Each src/math/<test>.c is built with <prefix>/bin/m68k-amigaos-gcc -mcrt=<crt>
# and the cflags, and run with <prefix>/bin/volamos, with an FPU when the cflags
# have -m68881.  libc-test's own runner needs fork(), so it is not used.  The
# results go to <outdir>/<test>.log, one line per test to <outdir>/summary.txt.
# The exit status is 1 when a test failed to build or run.

set -euo pipefail

src=$1/src
out=$2
bin=$3/bin
crt=$4
shift 4

# one <test> [cflags...]: build and run one test, print its result
one() {
	local name=$1 exe=$out/$1 cpu=()
	shift
	case " $* " in
	*" -m68881 "*) cpu=(--cpu 68020 --fpu) ;;
	*" -m680"[2-6]*) cpu=(--cpu 68020) ;;
	esac
	if ! "$bin/m68k-amigaos-gcc" -mcrt="$crt" "$@" -O2 -std=c99 -fno-builtin \
		-frounding-math -D_POSIX_C_SOURCE=200809L -w -I"$src/common" \
		"$src/math/$name.c" "$src/common/mtest.c" "$src/common/print.c" \
		-o "$exe" -lm >"$exe.log" 2>&1; then
		echo "BUILD $name"
	elif timeout 300 "$bin/volamos" --stack 4096K "${cpu[@]}" "$exe" >>"$exe.log" 2>&1; then
		echo "PASS $name"
	else
		echo "FAIL $name"
	fi
}
export -f one
export src out bin crt

mkdir -p "$out"
# shellcheck disable=SC2016 # the script for bash -c expands its own arguments
find "$src/math" -maxdepth 1 -name '*.c' -printf '%f\n' | sed 's/\.c$//' |
	xargs -P "$(getconf _NPROCESSORS_ONLN)" -I{} bash -c 'one "$@"' _ {} "$@" |
	sort -k2 >"$out/summary.txt"

for r in PASS FAIL BUILD; do
	printf '%s %d\n' "$r" "$(grep -c "^$r " "$out/summary.txt" || true)"
done
! grep -q -v '^PASS ' "$out/summary.txt"
