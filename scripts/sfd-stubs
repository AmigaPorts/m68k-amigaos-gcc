#!/usr/bin/perl
# Write libamiga.a's sources from SFD files: one C-callable stub per public
# function (<outdir>/<Function>.S) and the _LVO symbols of each library
# (<outdir>/lvo_<name>.S).
#
# A stub takes its arguments from the stack, loads them into the registers
# the SFD names, and calls the function through the library base variable
# (_SysBase, _DOSBase, ...), a4-relative when built with -fbaserel.  A base
# that is itself an argument (cia.resource, in a6) comes from the stack too.
# A function with "..." gets the address of its first variable argument in
# the last register.  A result narrower than a long is widened in d0, as the
# stubs of the binary amiga.lib did.
#
# sfdc --mode=stubs is not used: its inline asm lists the result and
# argument registers as clobbers, which gcc no longer accepts.
use strict;
use warnings;

@ARGV >= 2 or die "usage: $0 <outdir> <file.sfd>...\n";
my $outdir = shift;
my %seen;

# result types narrower than a long, and how to widen them
my %widen = (
  (map { $_ => ["ext.l\td0"] } qw(WORD SHORT BOOL COUNT RPTR)),
  (map { $_ => ["and.l\t#65535,d0"] } qw(UWORD USHORT UCOUNT WORDBITS)),
  (map { $_ => ["and.l\t#255,d0"] } qw(UBYTE TEXT BYTEBITS)),
  BYTE => ["ext.w\td0", "ext.l\td0"],
);

sub stub {
  my ($sfd, $base, $name, $bias, $type, $varargs, @regs) = @_;
  my $own = grep { $_ eq 'a6' } @regs;
  if (!$base && !$own) {
    warn "$sfd: $name: no library base, skipped\n";
    return;
  }
  die "$sfd: $name: defined twice\n" if $seen{lc $name}++;
  # registers the C ABI wants preserved
  my %used = map { $_ => 1 } map { split /-/ } @regs;
  my @save = grep { $used{$_} } qw(d2 d3 d4 d5 d6 d7 a2 a3 a4 a5);
  push @save, 'a6';
  my $off = 4 + 4 * @save;
  my @code;
  push @code, @save > 1 ? "movem.l\t" . join('/', @save) . ",-(sp)" : "move.l\ta6,-(sp)";
  push @code, "LOADBASE(_$base)" unless $own;
  for my $i (0 .. $#regs) {
    my $r = $regs[$i];
    if ($varargs && $i == $#regs) {
      push @code, $r =~ /^a/ ? "lea\t$off(sp),$r" : ("moveq\t#$off,$r", "add.l\tsp,$r");
    } elsif ($r =~ /^(d\d)-(d\d)$/) {
      push @code, "move.l\t$off(sp),$1", "move.l\t" . ($off + 4) . "(sp),$2";
      $off += 8;
    } else {
      push @code, "move.l\t$off(sp),$r";
      $off += 4;
    }
  }
  push @code, "jsr\t-$bias(a6)";
  push @code, @{$widen{$type}} if $widen{$type};
  push @code, @save > 1 ? "movem.l\t(sp)+," . join('/', @save) : "move.l\t(sp)+,a6";
  push @code, "rts";
  open my $o, '>', "$outdir/$name.S" or die "$outdir/$name.S: $!\n";
  print $o "#ifdef __baserel__\n#define LOADBASE(b) move.l b:W(a4),a6\n",
           "#else\n#define LOADBASE(b) move.l b,a6\n#endif\n",
           "\t.text\n\t.even\n\t.globl\t_$name\n_$name:\n",
           map { "\t$_\n" } @code;
  close $o;
}

for my $sfd (@ARGV) {
  (my $lib = $sfd) =~ s{.*/|_lib\.sfd$}{}g;
  open my $in, '<', $sfd or die "$sfd: $!\n";
  my ($base, $bias, $public, $kind, $proto, $last, @lvo) = ('', 30, 1, '', '', 0);
  while (my $line = <$in>) {
    $line =~ s/\s+$//;
    next if $line =~ /^\*/ || $line eq '';
    if ($line =~ /^==(\w+)\s*(.*)/) {
      my ($d, $arg) = ($1, $2);
      last if $d eq 'end';
      if    ($d eq 'base')    { ($base = $arg) =~ s/^_// }
      elsif ($d eq 'bias')    { $bias = $arg }
      elsif ($d eq 'reserve') { $bias += 6 * $arg }
      elsif ($d eq 'public')  { $public = 1 }
      elsif ($d eq 'private') { $public = 0 }
      elsif ($d eq 'alias' || $d eq 'varargs') { $kind = $d }
      next;
    }
    # a prototype can span lines; the register list ends it
    $proto .= " $line";
    next unless $proto =~ /^\s*(.*?)\s*(\w+)\s*\((.*)\)\s*\(([^()]*)\)$/;
    my ($type, $name, $args, $regs) = ($1, $2, $3, lc $4);
    $proto = '';
    $regs =~ s/\s//g;
    if ($kind eq '') {
      $last = $bias;
      $bias += 6;
      push @lvo, [$name, $last];
    }
    stub($sfd, $base, $name, $last, $type, $args =~ /\.\.\./ ? 1 : 0, split /,/, $regs) if $public;
    $kind = '';
  }
  close $in;
  open my $o, '>', "$outdir/lvo_$lib.S" or die "$outdir/lvo_$lib.S: $!\n";
  print $o map { "\t.globl\t_LVO$_->[0]\n_LVO$_->[0] = -$_->[1]\n" } @lvo;
  close $o;
}
