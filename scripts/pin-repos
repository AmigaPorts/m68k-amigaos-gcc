#!/bin/bash
# Pin the modules of default-repos to the heads of their branches.
#
#   scripts/pin-repos [MODULE...]
#
# The fourth column of default-repos is the commit each module is pinned
# to, which the Nix package builds.  This resolves each module's branch on
# its remote and writes the commit there; with MODULEs, only those.

set -euo pipefail

# The top of this repository, wherever in it the script is.
here=$(git -C "$(dirname "$(readlink -f "$0")")" rev-parse --show-toplevel)
repos=$here/default-repos

for want in "$@"; do
	grep -q "^$want[[:blank:]]" "$repos" || { echo "unknown module: $want" >&2; exit 1; }
done

pinned=$(mktemp)
trap 'rm -f "$pinned"' EXIT

while IFS= read -r line; do
	read -r name url branch rev _ <<<"$line"
	case $name in ''|'#'*) printf '%s\n' "$line"; continue ;; esac
	if [ $# -eq 0 ] || [[ " $* " == *" $name "* ]]; then
		head=$(git ls-remote "$url" "refs/heads/$branch" | cut -f1)
		[ -n "$head" ] || { echo "$name: no branch $branch at $url" >&2; exit 1; }
		[ "$head" = "$rev" ] || echo "$name: ${rev:-unpinned} -> $head" >&2
		rev=$head
	fi
	printf '%-18s %-46s %-12s %s\n' "$name" "$url" "$branch" "$rev"
done < "$repos" > "$pinned"

cat "$pinned" > "$repos"
