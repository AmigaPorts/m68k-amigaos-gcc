-cc=PREFIX/bin/vbccm68k -quiet %s -o= %s %s -O=%ld -IPREFIX/m68k-amigaos/vbcc/include -IPREFIX/m68k-amigaos/ndk-include
-ccv=PREFIX/bin/vbccm68k %s -o= %s %s -O=%ld -IPREFIX/m68k-amigaos/vbcc/include -IPREFIX/m68k-amigaos/ndk-include
-as=PREFIX/bin/vasmm68k_mot -quiet -Fhunk -nowarn=62 %s -o %s
-asv=PREFIX/bin/vasmm68k_mot -Fhunk -nowarn=62 %s -o %s
-rm=rm -f %s
-rmv=rm %s
-ld=PREFIX/bin/vlink -bamigahunk -x -Bstatic -Cvbcc -nostdlib -mrel PREFIX/m68k-amigaos/vbcc/lib/startup.o %s %s -LPREFIX/m68k-amigaos/vbcc/lib -lvc -o %s
-l2=PREFIX/bin/vlink -bamigahunk -x -Bstatic -Cvbcc -nostdlib -mrel %s %s -LPREFIX/m68k-amigaos/vbcc/lib -o %s
-ldv=PREFIX/bin/vlink -bamigahunk -t -x -Bstatic -Cvbcc -nostdlib -mrel PREFIX/m68k-amigaos/vbcc/lib/startup.o %s %s -LPREFIX/m68k-amigaos/vbcc/lib -lvc -o %s
-l2v=PREFIX/bin/vlink -bamigahunk -t -x -Bstatic -Cvbcc -nostdlib -mrel %s %s -LPREFIX/m68k-amigaos/vbcc/lib -o %s
-ldnodb=-s -Rshort
-ul=-l%s
-cf=-F%s
-ml=500
-hunkdebug
-amiga-softfloat
