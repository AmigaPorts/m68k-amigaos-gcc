@@ -1709,6 +1709,23 @@ write_words (
   return true;
 }
 
+/* Amiga hunk fields are fixed-width even when bfd_size_type is wider than
+   unsigned long, as it is on 64-bit Windows hosts.  Convert the value rather
+   than passing a pointer to an incompatible representation.  */
+static bool
+write_bfd_size_long (bfd_size_type in, bfd *abfd)
+{
+  unsigned long value = (unsigned long) in;
+  return write_longs (&value, 1, abfd);
+}
+
+static bool
+write_bfd_size_word (bfd_size_type in, bfd *abfd)
+{
+  unsigned long value = (unsigned long) in;
+  return write_words (&value, 1, abfd);
+}
+
